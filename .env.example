# SQLite database file (default: ljadev/data/aiinsclaim.db)
DATABASE_PATH=

# Local document storage (default: ljadev/storage/claim-documents)
STORAGE_PATH=

# Session cookie encryption (min 32 chars in production)
SESSION_SECRET=dev-only-change-me-in-production-32chars

# Secret header value for POST /api/sweep/sla (production cron)
SWEEP_SECRET=

# Optional: OpenAI-compatible endpoint for agent features (later PBIs)
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
